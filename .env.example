# Copy this file to  .env  and fill in the three Supabase values.
# Supabase dashboard → Project Settings → API Keys

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable key"  (starts with sb_publishable_ ).  Used only for sign-in calls.
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# "Secret key"  (starts with sb_secret_ ).  SECRET: full database access. Only ever put it in this .env file
# (never in HTML/JS, never on GitHub).  Older projects: the legacy anon / service_role keys also work here.
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY

# Optional
SITE_URL=                # your public address once deployed, e.g. https://yourdomain.com (used in sign-up email links)
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=0        # set to 1 when the site is served over https
